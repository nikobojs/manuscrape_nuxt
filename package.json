{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "version": "1.1.8",
  "license": "MIT",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "build": "nuxt build && cp -r server/drizzle .output/server/drizzle",
    "dev": "nuxt dev",
    "db:generate": "yarn drizzle-kit generate",
    "db:migrate": "yarn drizzle-kit migrate",
    "cleanup-observation-data": "tsx scripts/cleanup-observation-data.ts",
    "docker-up": "docker compose up --detach",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test-dev": "vitest dev",
    "test": "vitest run --disableConsoleIntercept --silent=false",
    "full-test": "./test/run_all.sh",
    "test-ui": "vitest --ui"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.0",
    "@iconify-json/mdi": "^1.1.60",
    "@nuxt/devtools": "^4.2.0",
    "@sentry/node": "^11.15.0",
    "@sentry/vue": "^11.15.0",
    "@types/archiver": "^8.0.0",
    "@types/formidable": "^3.4.5",
    "@types/node": "^24.19.2",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.5.8",
    "@vitest/ui": "^5.1.1",
    "drizzle-kit": "^0.31.8",
    "nodemailer": "^10.6.1",
    "nuxt": "^4.2.2",
    "nuxt-umami": "3.2.1",
    "pm2": "^7.1.2",
    "sass": "^1.85.1",
    "typescript": "^5.8.2",
    "vuedraggable": "^4.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.758.0",
    "@iconify-json/lucide": "^1.2.157",
    "@node-saml/passport-saml": "^5.1.1",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxt/ui": "^4",
    "altcha": "^3.3.0",
    "altcha-lib": "^2.6.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "formidable": "^3.5.1",
    "jose": "^6.2.12",
    "nuxt-auth-utils": "^0.6.2",
    "passport": "^0.7.0",
    "pg": "^8.17.2",
    "postgres": "^3.4.8",
    "semver": "^7.6.3",
    "sharp": "^0.35.5",
    "stream-buffers": "^3.0.3",
    "tailwindcss": "^4.3.5",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.2.2",
    "yup": "^1.4.0"
  }
